SECRET_KEY="secret-key"
SALT_KEY="583l5Y4hl9WCwIu3qSpTctFZochMoegbghahnyUhUYE="
DEBUG=True
# Public origins. Required in production (DEBUG off): a missing/localhost BASE_URL fails the
# common.E001 system check, which stops `migrate` (and the telegram bot) from starting.
# BASE_URL=https://api.example.org
# FRONTEND_BASE_URL=https://events.example.org
# Comma-separated list of allowed hosts. Include host.docker.internal for Prometheus scraping from Docker
ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
TELEGRAM_BOT_TOKEN="0000000000:AABBCCDD"

# POSTGRES
DB_USER=revel
DB_PASSWORD=db-password
DB_NAME=revel
DB_PORT=5432

# REDIS (cache + Celery broker + aiogram FSM, one instance split by DB index)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# Logical DB indices — keep disjoint; `cache.clear()` is a FLUSHDB on its own index.
#   CACHE_REDIS_DB=2   Django cache
#   CELERY_REDIS_DB=0  Celery broker
#   AIOGRAM_REDIS_DB=1 Telegram bot FSM state
# CACHE_REDIS_DB=2
# Per-operation socket timeouts (seconds) for the Django cache client. Bound every
# cache op so a hung Redis errors out instead of blocking requests indefinitely (#880).
# REDIS_SOCKET_CONNECT_TIMEOUT=1.0
# REDIS_SOCKET_TIMEOUT=1.0

APPLE_TEAM_IDENTIFIER=FOOBAR

# Apple Wallet Pass Configuration (optional)
# Required to enable Apple Wallet ticket passes
# APPLE_WALLET_PASS_TYPE_ID=pass.com.example.event
# APPLE_WALLET_TEAM_ID=XXXXXXXXXX
# APPLE_WALLET_CERT_PATH=/path/to/pass-certificate.pem
# APPLE_WALLET_KEY_PATH=/path/to/pass-key.pem
# APPLE_WALLET_KEY_PASSWORD=your-key-password
# APPLE_WALLET_WWDR_CERT_PATH=/path/to/wwdr-certificate.pem

# Google Wallet (optional) — https://developers.google.com/wallet/tickets/events
# GOOGLE_WALLET_ISSUER_ID=3388000000000000000
# GOOGLE_WALLET_SERVICE_ACCOUNT_KEY_PATH=/path/to/google-wallet-sa.json
# GOOGLE_WALLET_CLASS_PREFIX=revel

# LLM Configuration (questionnaire evaluation)
# Format: "provider/model-name". See revel/settings/llm.py for details.
# Supported providers: https://python.useinstructor.com/integrations/
#
# Local dev with Ollama (default): no extra config needed.
# Production with OpenAI: set LLM_DEFAULT_MODEL=openai/gpt-4o-mini and LLM_API_KEY.
LLM_DEFAULT_MODEL="ollama/llama3.1:8b"
# LLM_API_KEY=sk-your-openai-key
# LLM_BASE_URL=
# LLM_MAX_RETRIES=3
# LLM_INSTRUCTOR_MODE: JSON (default), TOOLS, JSON_SCHEMA, MD_JSON, or empty for auto-detect.
# See instructor.Mode for all available options.
# LLM_INSTRUCTOR_MODE=JSON

STRIPE_ACCOUNT=acct_
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
# CSV of all webhook signing secrets (platform + Connect endpoints). When set,
# takes precedence over STRIPE_WEBHOOK_SECRET.
STRIPE_WEBHOOK_SECRETS=
STRIPE_API_VERSION=2026-03-25.dahlia
STRIPE_WEBHOOK_EVENT_RETENTION_DAYS=90

# When True, it exposes an endpoint for fake logins with @example.com emails
# Warning: SET TO FALSE IN PRODUCTION
DEMO_MODE=True

# Django Silk profiling UI (dev-only). Its middleware writes a request row to Postgres per
# request, which deadlocks under parallel load — set to False for frontend E2E / parallel-load
# runs to avoid sporadic 500s (see docs/getting-started/troubleshooting.md, issue #671).
SILK_PROFILER=False

# Feature Flags (self-hosting). All default to True (full SaaS behaviour);
# set to False to drop the corresponding optional dependency.
# Skip the ClamAV scan and mark uploads clean immediately (run without antivirus).
FEATURE_MALWARE_SCAN=True
# Strip Telegram from notification delivery and 404 the linking endpoints (run without the bot).
FEATURE_TELEGRAM=True
# Block non-staff users from creating organizations (recommended for single-org instances).
FEATURE_ORGANIZATION_CREATION=True

# Generic OpenID Connect login. Empty = disabled. See docs/self-hosting/tiers.md.
OIDC_PROVIDERS=
# OIDC_GOOGLE_ISSUER=https://accounts.google.com
# OIDC_GOOGLE_CLIENT_ID=
# OIDC_GOOGLE_CLIENT_SECRET=

# External listing platforms (Eventbrite). Both values empty = provider not offered.
# App credentials: https://www.eventbrite.com/account-settings/apps ("API Key" is the client id).
# The app's OAuth redirect URI must be {BASE_URL}/api/integrations/eventbrite/callback.
# Note: Eventbrite blocks localhost/127.0.0.1 redirect URIs — use a hosts-file alias locally.
INTEGRATIONS_EVENTBRITE_CLIENT_ID=
INTEGRATIONS_EVENTBRITE_CLIENT_SECRET=
# INTEGRATIONS_RATE_RESERVE=200  # Calls kept in reserve so organizer actions never starve behind the reconcile sweep.
# INTEGRATIONS_WEBHOOK_DELIVERY_RETENTION_DAYS=30  # Days a WebhookDelivery audit row is kept before the daily prune.

# Observability Configuration
# Set to False for CI/testing, True for local dev with observability.
# (Legacy name ENABLE_OBSERVABILITY is still honoured as a deprecated alias.)
FEATURE_OBSERVABILITY=True
SERVICE_NAME=revel
# development, staging, production
DEPLOYMENT_ENVIRONMENT=development
# Trust X-Forwarded-Proto from the TLS-terminating proxy (Caddy). Defaults to on when DEBUG is off;
# set False only when Django is exposed directly with no proxy in front.
# TRUST_X_FORWARDED_PROTO=True
# 100% sampling in dev, use 0.1 (10%) in production
TRACING_SAMPLE_RATE=1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# CI/tests use docker-compose-dev.yml which doesn't include observability services

AWS_STORAGE_BUCKET_NAME="fake-bucket"
AWS_ACCESS_KEY_ID="fake-key-id"

# Email Configuration (Mailpit for local development)
# Mailpit Web UI: http://localhost:8025
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
# Optional dedicated sending domain for mail that organizations push to people
# (announcements, invitations, event updates and reminders), e.g. mail.letsrevel.io,
# so its reputation is kept apart from account mail (verification, password reset,
# tickets). Unset or empty -> falls back to the domain of DEFAULT_FROM_EMAIL.
# Authenticate the domain (DKIM + DMARC) at your SMTP provider before setting it.
# It needs no MX record, but do NOT publish a null MX (RFC 7505): a null-MX
# domain must not be used as a From domain.
# ORG_EMAIL_DOMAIN=mail.letsrevel.io
# Optional shared secret for the provider's bounce/complaint webhook,
# POST https://<API_DOMAIN>/api/email-events/brevo. Sent as
# "Authorization: Bearer <secret>" or as the basic-auth password, e.g. the URL
# https://revel:<secret>@<API_DOMAIN>/api/email-events/brevo in Brevo's webhook
# settings. Unset or empty -> feature off (the endpoint returns 404).
# EMAIL_WEBHOOK_SECRET=
# Org-setup nudges (opt-out-able reminders to owners of stalled orgs): Reply-To so
# owners can answer a human, and the name signing the personal check-in email.
# ORG_NUDGE_REPLY_TO=
# ORG_NUDGE_SIGNATURE=The Revel team
# Per organization and UTC day, how many invitations may go to addresses that have
# no Revel account yet (cold mail). A request that would exceed it is rejected whole
# with a 400. Resets at midnight UTC. 0 -> unlimited.
# PENDING_INVITATION_DAILY_CAP=200
# Unsubscribe links in emails stay valid this long (default ~10 years), so the
# one-click unsubscribe keeps working on old mail.
# UNSUBSCRIBE_TOKEN_LIFETIME_DAYS=3650

# Admin pings (optional, silently skipped when unset)
# Pushover — https://pushover.net/
# PUSHOVER_USER_KEY=
# PUSHOVER_APP_TOKEN=
# Discord webhook URL for PII-free admin pings (new user / new organization)
# DISCORD_ADMIN_WEBHOOK_URL=

# Grafana / Loki log access (scripts/loki_logs.py — read production logs)
# Service-account token (Viewer role) from grafana.letsrevel.io.
# GRAFANA_TOKEN=
# Optional overrides (sane defaults baked in):
# GRAFANA_URL=https://grafana.letsrevel.io
# GRAFANA_LOKI_UID=loki

# other stuff

# OAuth 2.1 / OIDC provider — enabled when the signing key path is set AND readable.
# Generate with: python manage.py generate_oidc_signing_key --out certs/oidc.pem
# The command writes the PEM 0600 for the host user; the container runs as uid 997, so
# `chmod 644 certs/oidc.pem` before mounting it. An unreadable key leaves the provider
# off (the rest of the API keeps serving) and every management command warns oauth.W002.
# OAUTH_ISSUER is required once the key is readable: a key without an issuer fails the
# oauth.E001 check and stops web from starting (see docs/self-hosting/troubleshooting.md).
# Retired keys (comma-separated) stay published in /o/jwks during a rotation.
# OIDC_SIGNING_KEY_PATH=/app/certs/oidc.pem
# OIDC_SIGNING_KEYS_INACTIVE_PATHS=
# OAUTH_ISSUER=https://api.letsrevel.io
# Optional tuning (defaults shown): developer-portal apps per user, instance-wide dynamic
# client registrations per day, and hours an unused dynamically registered app is kept.
# OAUTH_MAX_APPS_PER_USER=10
# OAUTH_DCR_DAILY_CAP=500
# OAUTH_DCR_UNUSED_TTL_HOURS=24
