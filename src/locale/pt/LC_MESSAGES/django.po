#, python-format
msgid "Password must be at least %(min_length)d characters long."
msgstr "A palavra-passe deve ter pelo menos %(min_length)d caracteres."

msgid "Password must contain at least one uppercase letter."
msgstr "A palavra-passe deve conter pelo menos uma letra maiúscula."

msgid "Password must contain at least one lowercase letter."
msgstr "A palavra-passe deve conter pelo menos uma letra minúscula."

msgid "Password must contain at least one digit."
msgstr "A palavra-passe deve conter pelo menos um algarismo."

msgid ""
"Password must contain at least one special character (!@#$%^&*(),.?\":{}|<>)"
"[]=."
msgstr ""
"A palavra-passe deve conter pelo menos um caráter especial (!@#$%^&*(),.?\":"
"{}|<>)[]=."

