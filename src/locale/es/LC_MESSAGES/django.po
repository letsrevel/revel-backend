msgstr "Las ventas de este plan están pausadas actualmente."

msgid "This plan is sold out."
msgstr "Este plan está agotado."

msgid "You can't rejoin this organization."
msgstr "No puedes volver a unirte a esta organización."

msgid ""
"Cannot change currency when active subscriptions exist. Archive and create a "
"new plan instead."
msgstr ""
"No se puede cambiar la moneda mientras existan suscripciones activas. "
"Archiva el plan y crea uno nuevo en su lugar."

msgid "Cannot delete a plan with existing subscriptions. Archive it instead."
msgstr ""
"No se puede eliminar un plan con suscripciones existentes. Archívalo en su "
"lugar."

msgid ""
"Cannot schedule cancellation for a paused subscription. Resume it first, or "
"cancel immediately."
msgstr ""
"No se puede programar la cancelación de una suscripción pausada. Reanúdala "
"primero, o cancélala inmediatamente."

