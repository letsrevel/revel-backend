msgid "Only the ticket holder can view this preview."
msgstr "Solo quien posee la entrada puede ver esta vista previa."

msgid "Only the ticket holder can cancel this ticket."
msgstr "Solo quien posee la entrada puede cancelarla."

msgid "Refund failed. Please try again later."
msgstr "El reembolso ha fallado. Inténtalo de nuevo más tarde."

msgid "Not allowed."
msgstr "No permitido."

msgid ""
"This subscription is managed by the organization. Contact them to change "
"your plan."
msgstr ""
"Esta suscripción la gestiona la organización. Contacta con ella para cambiar "
"de plan."

msgid ""
"This subscription is managed by the organization. Contact them to renew your "
"membership."
msgstr ""
"Esta suscripción la gestiona la organización. Contacta con ella para renovar "
"tu membresía."

msgid "Organization creation is disabled on this instance."
msgstr "La creación de organizaciones está deshabilitada en esta instancia."

msgid "Message sent."
msgstr "Mensaje enviado."

msgid "Token does not match this organization."
msgstr "El token no corresponde a esta organización."

msgid "Only the organization owner can create staff members."
msgstr "Solo el propietario de la organización puede crear miembros del staff."

msgid "Only the organization owner can change staff permissions."
msgstr ""
"Solo el propietario de la organización puede cambiar los permisos del staff."

msgid ""
"ONLINE plans must be subscribed to by the member directly. Send them to the "
"member-facing subscribe endpoint."
msgstr ""
"Los planes ONLINE debe suscribirlos el miembro directamente. Remítelo al "
"endpoint de suscripción para miembros."

msgid ""
"FREE plans cost nothing, so no initial payment can be recorded against them."
msgstr ""
"Los planes FREE no cuestan nada, así que no se puede registrar ningún "
"pago inicial para ellos."

msgid ""
"ONLINE subscription payments are recorded automatically via Stripe webhooks."
msgstr ""
"Los pagos de suscripciones ONLINE se registran automáticamente mediante los "
"webhooks de Stripe."

msgid "FREE subscriptions have no payments to record."
msgstr "Las suscripciones FREE no tienen pagos que registrar."

msgid ""
"ONLINE payments must be refunded from the Stripe Dashboard; the refund is "
"recorded here automatically."
msgstr ""
"Los pagos ONLINE deben reembolsarse desde el panel de Stripe; el reembolso "
"se registra aquí automáticamente."

msgid "Invoice PDF not yet generated."
msgstr "El PDF de la factura aún no se ha generado."

msgid "Invoice PDF could not be generated."
msgstr "No se ha podido generar el PDF de la factura."

msgid ""
"Your payment went through. We're still confirming your subscription — check "
"back in a moment."
msgstr ""
"Tu pago se ha realizado correctamente. Todavía estamos confirmando tu "
"suscripción — vuelve a comprobarlo en un momento."

msgid "You have created too many items."
msgstr "Has creado demasiados elementos."

msgid "You are already a member of this organization."
msgstr "Ya eres miembro de esta organización."

msgid "You have a pending membership request for this organization."
msgstr "Tienes una solicitud de membresía pendiente para esta organización."

msgid "Invalid Stripe signature"
msgstr "Firma de Stripe no válida"

msgid "A discount code with this code already exists."
msgstr "Ya existe un código de descuento con este código."

msgid "Payment processing failed. Please try again later."
msgstr "El procesamiento del pago ha fallado. Inténtalo de nuevo más tarde."

msgid "Draft"
msgstr "Borrador"

msgid "Scheduled"
msgstr "Programado"

msgid "Sent"
msgstr "Enviado"

msgid "Event start"
msgstr "Inicio del evento"

msgid "Event end"
msgstr "Fin del evento"

msgid "Event attendees"
msgstr "Asistentes al evento"

msgid "All members"
msgstr "Todos los miembros"

msgid "Specific membership tiers"
msgstr "Niveles de membresía específicos"

msgid "Staff only"
msgstr "Solo staff"

msgid "Target all active organization members"
msgstr "Enviar a todos los miembros activos de la organización"

msgid "Target members of specific membership tiers"
msgstr "Enviar a los miembros de niveles de membresía específicos"

msgid "Target only organization staff members"
msgstr "Enviar solo a los miembros del staff de la organización"

msgid "Allow new attendees/members to see this announcement after it was sent"
msgstr ""
"Permitir que los nuevos asistentes/miembros vean este anuncio después de su "
"envío"

msgid ""
"Absolute time to send a scheduled announcement (mutually exclusive with "
"relative scheduling)."
msgstr ""
"Hora absoluta para enviar un anuncio programado (mutuamente excluyente con "
"la programación relativa)."

msgid "Anchor a relative schedule to the event start or end."
msgstr "Anclar una programación relativa al inicio o al final del evento."

msgid "Signed minutes from the anchor (-1440 = 24h before, +1440 = 24h after)."
msgstr ""
"Minutos con signo desde el ancla (-1440 = 24 h antes, +1440 = 24 h después)."

msgid ""
"Re-deliver to attendees who join after this announcement was first sent "
"(event announcements only)."
msgstr ""
"Reenviar a los asistentes que se apunten después del primer envío de este "
"anuncio (solo para anuncios de evento)."

msgid "Relative scheduling requires both an anchor and an offset."
msgstr ""
"La programación relativa requiere tanto un ancla como un desplazamiento."

msgid "Provide either an absolute time or a relative schedule, not both."
msgstr "Indica una hora absoluta o una programación relativa, no ambas."

msgid "Relative scheduling requires an event-targeted announcement."
msgstr "La programación relativa requiere un anuncio dirigido a un evento."

msgid "Re-sending to new sign-ups requires an event-targeted announcement."
msgstr ""
"El reenvío a las nuevas inscripciones requiere un anuncio dirigido a un "
"evento."

msgid "valid_until must be after valid_from."
msgstr "valid_until debe ser posterior a valid_from."

msgid "Percentage discount cannot exceed 100."
msgstr "El descuento porcentual no puede superar 100."

msgid "Currency is required for fixed amount discounts."
msgstr "La moneda es obligatoria para los descuentos de importe fijo."

msgid "Event series must belong to the same organization as the event."
msgstr ""
"La serie de eventos debe pertenecer a la misma organización que el evento."

msgid "End date must be after start date."
msgstr "La fecha de fin debe ser posterior a la fecha de inicio."

msgid "Check-in end time must be after check-in start time."
msgstr ""
"La hora de fin del check-in debe ser posterior a la hora de inicio del check-"
"in."

msgid "Venue must belong to the same organization as the event."
msgstr "El lugar debe pertenecer a la misma organización que el evento."

msgid "Time window must be at least 1 hour."
msgstr "La ventana temporal debe ser de al menos 1 hora."

msgid "Time window cannot exceed 7 days."
msgstr "La ventana temporal no puede superar los 7 días."

msgid "Cutoff date requires waitlist_time_window to be set."
msgstr "La fecha límite requiere que waitlist_time_window esté definido."

msgid "Cutoff date must be before event start."
msgstr "La fecha límite debe ser anterior al inicio del evento."

msgid "Days a PAST_DUE subscription stays valid before expiring."
msgstr ""
"Días que una suscripción PAST_DUE sigue siendo válida antes de caducar."

msgid ""
"Days after subscription expiry during which a member can revive in place. "
"Set to 0 to disable revival entirely."
msgstr ""
"Días tras la caducidad de la suscripción durante los cuales un miembro puede "
"reactivarla directamente. Ponlo a 0 para desactivar por completo la "
"reactivación."

msgid ""
"Default membership questionnaire applied to all tiers (overridable per tier)."
msgstr ""
"Cuestionario de membresía predeterminado aplicado a todos los niveles (se "
"puede sobrescribir por nivel)."

msgid "When True, every membership application requires manual staff approval."
msgstr ""
"Si es True, cada solicitud de membresía requiere la aprobación manual del "
"staff."

msgid ""
"A verified contact email is required to enable a contact method other than "
"NONE."
msgstr ""
"Se necesita un correo electrónico de contacto verificado para activar un "
"método de contacto distinto de NONE."

msgid "Default membership questionnaire must belong to this organization."
msgstr ""
"El cuestionario de membresía predeterminado debe pertenecer a esta "
"organización."

msgid "Membership questionnaire must be of type MEMBERSHIP."
msgstr "El cuestionario de membresía debe ser de tipo MEMBERSHIP."

msgid "Tier-specific membership questionnaire. NULL = inherit org default."
msgstr ""
"Cuestionario de membresía específico del nivel. NULL = hereda el valor "
"predeterminado de la organización."

msgid ""
"Tier-specific manual-approval override. NULL = inherit "
"org.default_requires_membership_approval."
msgstr ""
"Anulación de la aprobación manual específica del nivel. NULL = hereda "
"org.default_requires_membership_approval."

msgid "Membership questionnaire must belong to the same organization."
msgstr "El cuestionario de membresía debe pertenecer a la misma organización."

msgid "The tier must belong to the same organization as the membership."
msgstr "El nivel debe pertenecer a la misma organización que la membresía."

msgid "Membership tier is required when granting membership."
msgstr "El nivel de membresía es obligatorio al conceder una membresía."

msgid "Membership tier must belong to the same organization as the token."
msgstr ""
"El nivel de membresía debe pertenecer a la misma organización que el token."

msgid ""
"Target tier. NULL = tier-less legacy application; staff picks at approval."
msgstr ""
"Nivel de destino. NULL = solicitud heredada sin nivel; el staff lo elige al "
"aprobarla."

msgid "Target plan for the paid path. NULL = free join."
msgstr "Plan de destino para la vía de pago. NULL = adhesión gratuita."

msgid "Submission that satisfied the questionnaire gate, if applicable."
msgstr "Envío que ha superado el requisito del cuestionario, si procede."

msgid "Token must be a single non-empty slug segment."
msgstr "El token debe ser un único segmento de slug no vacío."

msgid "At-the-door payment is not supported for series passes."
msgstr "El pago en puerta no está disponible para los pases de serie."

msgid "Series passes cannot be invitation-restricted."
msgstr "Los pases de serie no pueden restringirse a personas invitadas."

msgid "Currency cannot be changed once the pass covers events."
msgstr "La moneda no se puede cambiar una vez que el pase cubre eventos."

msgid "Payment method cannot be changed while the pass has holders."
msgstr ""
"El método de pago no se puede cambiar mientras el pase tenga titulares."

msgid "Tier must belong to the covered event."
msgstr "El tipo de entrada debe pertenecer al evento cubierto."

msgid "Event must belong to the pass's series."
msgstr "El evento debe pertenecer a la serie del pase."

msgid "Tier currency must match the pass currency."
msgstr "La moneda del tipo de entrada debe coincidir con la moneda del pase."

msgid "Assigned-seating tiers cannot back a series pass."
msgstr ""
"Los tipos de entrada con asiento asignado no pueden respaldar un pase de "
"serie."

msgid "Pay What You Can tiers cannot back a series pass."
msgstr ""
"Los tipos de entrada \"Paga lo que puedas\" no pueden respaldar un pase de "
"serie."

msgid "Online (Stripe)"
msgstr "Online (Stripe)"

msgid "Offline (staff-managed)"
msgstr "Offline (gestionado por el staff)"

msgid "Free (member self-serve)"
msgstr "Gratuito (autoservicio para miembros)"

msgid "Month"
msgstr "Mes"

msgid "Year"
msgstr "Año"

msgid "Lifetime"
msgstr "De por vida"

msgid "Open"
msgstr "Abierto"

msgid "Paused"
msgstr "En pausa"

msgid "e.g. \"Monthly\", \"Annual\""
msgstr "p. ej. \"Mensual\", \"Anual\""

msgid "ISO 4217 currency code"
msgstr "Código de moneda ISO 4217"

msgid ""
"PAUSED stops member self-service sales (subscribe, revive, plan switches "
"into this plan) while leaving existing subscribers untouched. Orthogonal to "
"archiving: an archived plan is retired, a paused one is temporarily closed."
msgstr ""
"PAUSED detiene las ventas de autoservicio para los miembros (suscribirse, "
"reactivar, cambios de plan hacia este plan) sin afectar a los suscriptores "
"existentes. Es ortogonal al archivado: un plan archivado está retirado; uno "
"en pausa está cerrado temporalmente."

msgid ""
"Cap on concurrent non-terminal subscriptions (the venue's card stock). "
"Cancelled/expired subscriptions free their slot automatically. NULL = "
"unlimited."
msgstr ""
"Límite de suscripciones simultáneas no terminales (el stock de tarjetas del "
"local). Las suscripciones canceladas o caducadas liberan su plaza "
"automáticamente. NULL = ilimitado."

msgid ""
"ONLINE plans are billed via Stripe; OFFLINE plans are tracked manually by "
"staff; FREE plans cost nothing, are self-serve, and never renew (price 0 + "
"LIFETIME period)."
msgstr ""
"Los planes ONLINE se cobran mediante Stripe; los planes OFFLINE los gestiona "
"manualmente el personal; los planes FREE no cuestan nada, son de "
"autoservicio y nunca se renuevan (precio 0 + periodo LIFETIME)."

msgid "Past Due"
msgstr "Vencido"

msgid "Cancelled"
msgstr "Cancelado"

msgid "Expired"
msgstr "Caducado"

msgid ""
"Hosted Checkout Session that will (or did) create the Stripe Subscription."
msgstr ""
"Sesión de Checkout alojada que creará (o ha creado) la Subscription de "
"Stripe."

msgid "Plan that will replace ``plan`` at the next renewal (downgrade flow)."
msgstr ""
"Plan que sustituirá a ``plan`` en la próxima renovación (flujo de bajada de "
"plan)."

msgid ""
"Set when status transitions to EXPIRED. Used for the revival window check."
msgstr ""
"Se establece cuando el estado pasa a EXPIRED. Se usa para comprobar la "
"ventana de reactivación."

msgid "Subscription organization must match the plan's tier organization."
msgstr ""
"La organización de la suscripción debe coincidir con la organización del "
"nivel del plan."

msgid "Pending plan must belong to the same organization as the subscription."
msgstr ""
"El plan pendiente debe pertenecer a la misma organización que la suscripción."

msgid "Succeeded"
msgstr "Completado"

msgid "Failed"
msgstr "Fallido"

msgid "Refunded"
msgstr "Reembolsado"

msgid "Ticket sales must start before or at the event start time."
msgstr ""
"La venta de entradas debe comenzar como muy tarde a la hora de inicio del "
"evento."

msgid "Ticket sales end time must be after the sales start time."
msgstr ""
"La hora de fin de la venta de entradas debe ser posterior a la hora de "
"inicio de la venta."

msgid ""
"Maximum pay-what-you-can amount must be greater than or equal to minimum "
"amount."
msgstr ""
"El importe máximo de \"paga lo que puedas\" debe ser mayor o igual que el "
"importe mínimo."

msgid "All linked membership tiers must belong to the event's organization."
msgstr ""
"Todos los niveles de membresía vinculados deben pertenecer a la organización "
"del evento."

msgid ""
"If tickets are restricted to specific tiers, 'Purchasable By' must be set to "
"'Members only' or 'Invited and Members only'."
msgstr ""
"Si las entradas están restringidas a niveles concretos, 'Comprable por' debe "
"estar configurado como 'Solo miembros' o 'Solo invitados y miembros'."

msgid "Sector must belong to the specified venue."
msgstr "El sector debe pertenecer al lugar especificado."

msgid "Tier venue must match the event venue."
msgstr "El lugar del tipo de entrada debe coincidir con el del evento."

msgid "A sector is required for best-available seat assignment."
msgstr "Se necesita un sector para la asignación del mejor asiento disponible."

msgid "A sector is required for user-choice seat assignment."
msgstr ""
"Se necesita un sector para la asignación de asiento elegido por el usuario."

msgid ""
"User-choice seat assignment requires a seated sector, not a standing one."
msgstr ""
"La asignación de asiento elegido por el usuario requiere un sector con "
"asientos, no uno de pie."

msgid ""
"Best-available seat assignment requires a seated sector, not a standing one."
msgstr ""
"La asignación del mejor asiento disponible requiere un sector con asientos, "
"no uno de pie."

msgid "This option is only valid when visibility is set to 'Private'."
msgstr ""
"Esta opción solo es válida cuando la visibilidad está configurada como "
"'Privado'."

msgid ""
"This option is only valid when purchasable by is set to 'Invitees only' or "
"'Invited and Members only'."
msgstr ""
"Esta opción solo es válida cuando 'Comprable por' está configurado como "
"'Solo invitados' o 'Solo invitados y miembros'."

msgid "Cannot assign an inactive seat."
msgstr "No se puede asignar un asiento inactivo."

msgid "Seat must belong to the specified sector."
msgstr "El asiento debe pertenecer al sector especificado."

msgid "Seated"
msgstr "Plazas sentadas"

msgid "Standing"
msgstr "Plazas de pie"

msgid "Address visible to invited guests only"
msgstr "Dirección visible solo para las personas invitadas"

msgid "Address visible to organization members only"
msgstr "Dirección visible solo para los miembros de la organización"

msgid "Address visible to staff only"
msgstr "Dirección visible solo para el staff"

msgid "Address visible to attendees only"
msgstr "Dirección visible solo para los asistentes"

msgid "Only draft invoices can be edited."
msgstr "Solo se pueden editar las facturas en borrador."

#, python-brace-format
msgid "Cannot edit fields: {fields}"
msgstr "No se pueden editar los campos: {fields}"

msgid "Cancelled invoices cannot be issued."
msgstr "Las facturas canceladas no se pueden emitir."

msgid "Only draft invoices can be deleted."
msgstr "Solo se pueden eliminar las facturas en borrador."

msgid "Provide either seat_ids or price_category_id, not both."
msgstr "Proporciona seat_ids o price_category_id, no ambos."

msgid "That zone is no longer on sale — please choose another."
msgstr "Esa zona ya no está a la venta — elige otra."

msgid ""
"This ticket tier prices seats by category — seat_ids are required to preview "
"it."
msgstr ""
"Este tipo de entrada fija el precio por categoría de asiento — se necesitan "
"los seat_ids para la vista previa."

msgid "One or more selected seats are invalid or not in the correct sector."
msgstr ""
"Uno o más asientos seleccionados no son válidos o no están en el sector "
"correcto."

msgid "This ticket tier is sold out."
msgstr "Este tipo de entrada está agotado."

#, python-brace-format
msgid "Only {available} ticket(s) remaining for this tier."
msgstr "Solo quedan {available} entrada(s) de este tipo."

msgid "This event is sold out."
msgstr "Este evento está agotado."

#, python-brace-format
msgid "Only {available} spot(s) remaining for this event."
msgstr "Solo quedan {available} plaza(s) para este evento."

msgid "This sector is full."
msgstr "Este sector está completo."

#, python-brace-format
msgid "Only {available} spot(s) remaining in this sector."
msgstr "Solo quedan {available} plaza(s) en este sector."

msgid "You are not allowed to purchase from this tier."
msgstr "No puedes comprar entradas de este tipo."

msgid "You have reached the maximum number of tickets for this tier."
msgstr "Has alcanzado el número máximo de entradas para este tipo."

#, python-brace-format
msgid "You can only purchase {remaining} more ticket(s) for this tier."
msgstr "Solo puedes comprar {remaining} entrada(s) más de este tipo."

msgid "Seat selection is required for this ticket tier."
msgstr "Es obligatorio seleccionar asiento para este tipo de entrada."

msgid "One or more selected seats are no longer available."
msgstr "Uno o más asientos seleccionados ya no están disponibles."

msgid "One or more selected seats are held by another buyer."
msgstr "Uno o más asientos seleccionados están reservados por otro comprador."

msgid "Not enough accessible seats available — please contact the organizer."
msgstr ""
"No hay suficientes asientos accesibles disponibles — ponte en contacto con "
"la organización."

msgid "Not enough adjacent seats available for this tier."
msgstr ""
"No hay suficientes asientos contiguos disponibles para este tipo de entrada."

