msgstr "Asientos no encontrados en este sector: {}"

msgid ""
"Seats referenced by tickets or active holds cannot be deleted: {}. "
"Decommission them instead (set inactive)."
msgstr ""
"Los asientos referenciados por entradas o reservas activas no se pueden "
"eliminar: {}. Desactívalos en su lugar (márcalos como inactivos)."

